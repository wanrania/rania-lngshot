<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Judul Segitiga -->
        <TextView
            android:id="@+id/tvJudulSegitiga"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Luas Segitiga"
            android:textStyle="bold"
            android:textSize="18sp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent" />

        <EditText
            android:id="@+id/etAlas"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="Masukkan Alas"
            android:inputType="numberDecimal"
            app:layout_constraintTop_toBottomOf="@id/tvJudulSegitiga"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <EditText
            android:id="@+id/etTinggi"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="Masukkan Tinggi"
            android:inputType="numberDecimal"
            app:layout_constraintTop_toBottomOf="@id/etAlas"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <Button
            android:id="@+id/btnSegitiga"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Hitung Luas Segitiga"
            app:layout_constraintTop_toBottomOf="@id/etTinggi"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tvHasilSegitiga"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hasil:"
            android:textSize="16sp"
            app:layout_constraintTop_toBottomOf="@id/btnSegitiga"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- Judul Kubus -->
        <TextView
            android:id="@+id/tvJudulKubus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Volume Kubus"
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_marginTop="20dp"
            app:layout_constraintTop_toBottomOf="@id/tvHasilSegitiga"
            app:layout_constraintStart_toStartOf="parent" />

        <EditText
            android:id="@+id/etSisi"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hint="Masukkan Sisi"
            android:inputType="numberDecimal"
            app:layout_constraintTop_toBottomOf="@id/tvJudulKubus"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <Button
            android:id="@+id/btnKubus"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Hitung Volume Kubus"
            app:layout_constraintTop_toBottomOf="@id/etSisi"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/tvHasilKubus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Hasil:"
            android:textSize="16sp"
            app:layout_constraintTop_toBottomOf="@id/btnKubus"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</ScrollView>